{
  "manifest_version": 3,
  "name": "Skainet Chat Bridge — Project Safe",
  "version": "0.14.44",
  "description": "Project-safe Chat Bridge limited to ChatGPT, DeepSeek and Qwen, with a localhost Arena bridge.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    null,
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Skainet Chat Bridge — Project Safe"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "adapter_sites.js",
        "parser.js",
        "adapters.js",
        "insert_strategies.js",
        "settings.js",
        "insert_history.js",
        "shadow_toolbar.js",
        "diag.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shadow_toolbar.css"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Skainet Chat Bridge — Project Safe",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "skainet-chat-bridge@skainet.local",
      "strict_min_version": "115.0"
    }
  }
}
